@inject AuthService AuthService
@inherits DialogBase
@using System.ComponentModel.DataAnnotations

<MudDialog>
    <DialogContent>
        <EditForm Model="@changePasswordForm" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />

            <PasswordField @bind-Value="changePasswordForm.CurrentPassword"
                           For="@(() => changePasswordForm.CurrentPassword)"
                           Label="Senha Atual"
                           Required="true"
                           MaxLength="30"
                           Class="mb-3" />

            <PasswordField @bind-Value="changePasswordForm.NewPassword"
                           For="@(() => changePasswordForm.NewPassword)"
                           Label="Nova Senha"
                           Required="true"
                           MaxLength="30"
                           Class="mb-3" />

            <PasswordField @bind-Value="changePasswordForm.ConfirmNewPassword"
                           For="@(() => changePasswordForm.ConfirmNewPassword)"
                           Label="Confirmar Nova Senha"
                           Required="true"
                           MaxLength="30"
                           Class="mb-3" />


            <MudStack Spacing="4" Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton OnClick="Cancel" Color="Color.Error" Variant="Variant.Filled">
                    Cancelar
                </MudButton>

                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">
                    Salvar
                </MudButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {

    [Parameter]
    public string UserId { get; set; }

    private ChangePasswordViewModel changePasswordForm = new();

    private async Task OnValidSubmit(EditContext context)
    {
        await ExecuteAsync(async () =>
        {
            if (changePasswordForm.NewPassword == changePasswordForm.CurrentPassword)
            {
                ShowError("A nova senha deve ser diferente da atual.");
                return false;
            }

            if (changePasswordForm.NewPassword != changePasswordForm.ConfirmNewPassword)
            {
                ShowError("A confirmação da nova senha não confere.");
                return false;
            }

            var result = await AuthService.ChangePasswordAsync(
                UserId,
                changePasswordForm.CurrentPassword,
                changePasswordForm.NewPassword
            );

            if (!result.Success)
            {
                ShowError(result.Message);
                return false;
            }

            CloseOk(true);
            return true;
        },
        successMessage: "Senha alterada com sucesso!",
        errorMessage: "Ocorreu um erro inesperado ao alterar a senha. Tente novamente mais tarde.");
    }


    private class ChangePasswordViewModel
    {
        [Required(ErrorMessage = "Informe a senha atual")]
        [StringLength(30, ErrorMessage = "A senha deve ter no máximo 30 caracteres")]
        [RegularExpression(
        @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{6,}$",
        ErrorMessage = "A senha deve ter no mínimo 6 caracteres, incluindo letra maiúscula, minúscula, número e caractere especial."
        )]
        public string CurrentPassword { get; set; }

        [Required(ErrorMessage = "Informe a nova senha")]
        [StringLength(30, ErrorMessage = "A senha deve ter no máximo 30 caracteres")]
        [RegularExpression(
        @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{6,}$",
        ErrorMessage = "A senha deve ter no mínimo 6 caracteres, incluindo letra maiúscula, minúscula, número e caractere especial."
        )]
        public string NewPassword { get; set; }

        [Required(ErrorMessage = "Confirme a nova senha")]
        [StringLength(30, ErrorMessage = "A senha deve ter no máximo 30 caracteres")]
        [RegularExpression(
        @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{6,}$",
        ErrorMessage = "A senha deve ter no mínimo 6 caracteres, incluindo letra maiúscula, minúscula, número e caractere especial."
        )]
        [Compare("NewPassword", ErrorMessage = "A confirmação da senha não confere.")]
        public string ConfirmNewPassword { get; set; }
    }
}

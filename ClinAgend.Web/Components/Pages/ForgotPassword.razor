@page "/esqueci-senha"
@layout EmptyLayout
@inherits PageBase
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Small"
              Class="d-flex align-center justify-center forgot-password-container">

    @if (!emailSent)
    {
        <MudPaper Elevation="3"
                  Class="pa-8 forgot-password-card">

            <MudStack Spacing="1" Class="mb-6">

                <MudText Typo="Typo.h5"
                         Align="Align.Center"
                         Class="fw-bold">

                    Esqueceu sua senha?

                </MudText>

                <MudText Align="Align.Center"
                         Class="mt-2"
                         Typo="Typo.body2">

                    Informe seu e-mail abaixo para receber
                    o link de redefinição de senha.

                </MudText>

            </MudStack>

            <EditForm Model="@form"
                      OnValidSubmit="OnValidSubmit">

                <DataAnnotationsValidator />

                <MudTextField T="string"
                              @bind-Value="form.Email"
                              For="@(() => form.Email)"
                              MaxLength="100"
                              Label="E-mail"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Informe o e-mail"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-2" />

                <MudStack Row="true"
                          Justify="Justify.Center">

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Class="mt-4">

                        Enviar Link de Recuperação

                    </MudButton>

                </MudStack>

            </EditForm>

        </MudPaper>
    }
    else
    {
        <div class="success-screen">

            <div class="success-icon-wrapper">
                <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead"
                         Class="success-icon" />
            </div>

            <MudText Typo="Typo.h4"
                     Align="Align.Center"
                     Class="fw-bold mt-6">

                E-mail enviado!

            </MudText>

            <MudText Typo="Typo.body1"
                     Align="Align.Center"
                     Class="success-description mt-3">

                Se existir uma conta vinculada ao e-mail informado,
                você receberá um link para redefinir sua senha.

            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="mt-8 px-8"
                       OnClick="@(() => NavigationManager.NavigateTo("/login"))">

                Voltar para Login

            </MudButton>

        </div>
    }

</MudContainer>

<style>
    .forgot-password-container {
        min-height: 100vh;
        padding: 2rem;
    }

    .forgot-password-card {
        width: 100%;
        border-radius: 20px;
        background: white;
    }

    .success-screen {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        animation: fade-in 0.35s ease;
    }

    .success-icon-wrapper {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(33, 150, 243, 0.12);
    }

    .success-icon {
        font-size: 65px !important;
        color: #2196F3;
    }

    .success-description {
        max-width: 420px;
        line-height: 1.7;
        color: #6b7280;
    }

    @@keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 600px) {

        .forgot-password-card {
            padding: 2rem 1.5rem !important;
        }

        .success-description {
            max-width: 100%;
        }
    }
</style>

@code {

    private ForgotPasswordViewModel form = new();

    private bool emailSent;

    private async Task OnValidSubmit()
    {
        try
        {
            await AuthService.ForgotPasswordAsync(form.Email);

            emailSent = true;
        }
        catch
        {
            ShowError("Ocorreu um erro inesperado ao solicitar a recuperação de senha. Tente novamente mais tarde.");
        }
    }

    private class ForgotPasswordViewModel
    {
        [Required(ErrorMessage = "Informe o e-mail")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido")]
        [StringLength(100, ErrorMessage = "O e-mail deve ter no máximo 100 caracteres")]
        public string Email { get; set; }
    }

}
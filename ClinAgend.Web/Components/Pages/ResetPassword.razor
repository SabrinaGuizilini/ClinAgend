@page "/redefinir-senha"
@layout EmptyLayout
@inherits PageBase
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Small"
              Class="d-flex align-center justify-center reset-password-container">

    @if (!passwordChanged)
    {
        <MudPaper Elevation="3"
                  Class="pa-8 reset-password-card">

            <MudStack Spacing="1" Class="mb-6">
                <MudText Typo="Typo.h5"
                         Align="Align.Center"
                         Class="fw-bold">

                    Redefinir Senha

                </MudText>

                <MudText Align="Align.Center"
                         Class="mt-2"
                         Typo="Typo.body2">

                    Informe sua nova senha para concluir a redefinição.

                </MudText>
            </MudStack>

            <EditForm Model="@form" OnValidSubmit="OnValidSubmit">

                <DataAnnotationsValidator />

                <PasswordField @bind-Value="form.NewPassword"
                               For="@(() => form.NewPassword)"
                               Label="Nova Senha"
                               Required="true"
                               MaxLength="30"
                               Class="mb-3" />

                <PasswordField @bind-Value="form.ConfirmNewPassword"
                               For="@(() => form.ConfirmNewPassword)"
                               Label="Confirmar Nova Senha"
                               Required="true"
                               MaxLength="30"
                               Class="mb-2" />

                <MudStack Row="true"
                          Justify="Justify.Center"
                          Class="mt-4">

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large">

                        Redefinir Senha

                    </MudButton>

                </MudStack>

            </EditForm>

        </MudPaper>
    }
    else
    {
        <div class="success-screen">

            <div class="success-icon-wrapper">
                <MudIcon Icon="@Icons.Material.Filled.Check"
                         Class="success-icon" />
            </div>

            <MudText Typo="Typo.h4"
                     Align="Align.Center"
                     Class="fw-bold mt-6">

                Tudo pronto!

            </MudText>

            <MudText Typo="Typo.body1"
                     Align="Align.Center"
                     Class="success-description mt-3">

                Sua senha foi redefinida com sucesso.
                Agora você já pode acessar sua conta normalmente.

            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="mt-8 px-8"
                       OnClick="@(() => NavigationManager.NavigateTo("/login"))">

                Ir para Login

            </MudButton>

        </div>
    }

</MudContainer>

<style>
     .reset-password-container {
        min-height: 100vh;
        padding: 2rem;
    }

    .reset-password-card {
        width: 100%;
        border-radius: 20px;
    }

    .success-screen {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        animation: fade-in 0.35s ease;
    }

    .success-icon-wrapper {
        width: 120px;
        height: 120px;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        background: rgba(76, 175, 80, 0.12);
    }

    .success-icon {
        font-size: 70px !important;
        color: #4CAF50;
    }

    .success-description {
        max-width: 420px;
        line-height: 1.7;
        color: #6b7280;
    }

    @@keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private ResetPasswordViewModel form = new();

    private bool passwordChanged;

    private async Task OnValidSubmit()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Email) ||
                string.IsNullOrWhiteSpace(Token))
            {
                ShowError("Link de redefinição inválido.");
                return;
            }

            if (form.NewPassword != form.ConfirmNewPassword)
            {
                ShowError("A confirmação da senha não confere.");
                return;
            }

            var result = await AuthService.ResetPasswordAsync(
                Email,
                Token,
                form.NewPassword);

            if (!result.Success)
            {
                ShowError(result.Message);
                return;
            }

            passwordChanged = true;
        }
        catch
        {
            ShowError("Ocorreu um erro inesperado ao redefinir a senha. Tente novamente mais tarde.");
        }
    }

    private class ResetPasswordViewModel
    {
        [Required(ErrorMessage = "Informe a nova senha")]
        [StringLength(30, ErrorMessage = "A senha deve ter no máximo 30 caracteres")]
        [RegularExpression(
            @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{6,}$",
            ErrorMessage = "A senha deve ter no mínimo 6 caracteres, incluindo letra maiúscula, minúscula, número e caractere especial."
        )]
        public string NewPassword { get; set; }

        [Required(ErrorMessage = "Confirme a nova senha")]
        [StringLength(30, ErrorMessage = "A senha deve ter no máximo 30 caracteres")]
        [Compare("NewPassword", ErrorMessage = "A confirmação da senha não confere.")]
        public string ConfirmNewPassword { get; set; }
    }

}
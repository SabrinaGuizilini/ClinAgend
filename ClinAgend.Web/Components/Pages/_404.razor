@page "/404"
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small"
              Class="d-flex justify-center align-center"
              Style="min-height: 80vh;">

    <MudPaper Elevation="6" Class="pa-8 text-center">

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.Center"
                  Spacing="2">

            <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                     Color="Color.Secondary"
                     Size="Size.Large" />

            <MudText Typo="Typo.h4" Color="Color.Secondary">
                Página não encontrada
            </MudText>

        </MudStack>

        <MudText Typo="Typo.body1" Class="mt-3">
            A página que você tentou acessar não existe ou foi removida.
        </MudText>

        <MudText Typo="Typo.body2" Class="mt-2">
            Verifique o endereço digitado ou volte para a página inicial.
        </MudText>

        <MudDivider Class="my-6" />

        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-6">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Home"
                       OnClick="BackToIndex">
                Voltar para a página inicial
            </MudButton>
        </MudStack>

    </MudPaper>
</MudContainer>

@code {
    private void BackToIndex()
    {
        Navigation.NavigateTo("/");
    }
}
